---
layout: null
permalink: /search.json
---
[
{%- for post in site.posts %}
  {%- assign ckey = post.categories | first %}
  {%- assign cat = site.data.categories | where: "key", ckey | first %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y.%m.%d" | jsonify }},
    "category": {{ cat.name | default: "" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "text": {{ post.content | strip_html | strip_newlines | truncate: 600 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
